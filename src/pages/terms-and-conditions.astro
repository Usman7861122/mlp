---
// NOTE: This is a plain-language template. Have the practice's attorney review it before launch.
import LegalLayout from "../layouts/LegalLayout.astro";
import { site } from "../data/site";

const toc = [
  { id: "agreement", label: "Agreement to these terms" },
  { id: "not-medical-advice", label: "Not medical advice" },
  { id: "appointments", label: "Appointment requests" },
  { id: "use", label: "Using this website" },
  { id: "content", label: "Our content" },
  { id: "links", label: "Links to other sites" },
  { id: "disclaimer", label: "Disclaimer" },
  { id: "liability", label: "Limit of liability" },
  { id: "law", label: "Governing law" },
  { id: "changes", label: "Changes to these terms" },
  { id: "contact", label: "Contact us" },
];
---

<LegalLayout
  title="Terms and Conditions | Martin, Lee & Page OB GYN"
  description="The terms for using the Martin, Lee & Page OB GYN website in Memphis, TN."
  heading="Terms and"
  accent="Conditions"
  lead="Please read these terms before you use our website. By using it, you agree to them."
  updated="October 13, 2026"
  toc={toc}>
  <h2 id="agreement">Agreement to these terms</h2>
  <p>These terms apply to your use of this website, run by {site.name} ("we", "us"). If you do not agree, please do not use the website. Our <a href="/privacy-policy">Privacy Policy</a> and <a href="/cookie-policy">Cookie Policy</a> are part of these terms.</p>

  <h2 id="not-medical-advice">Not medical advice</h2>
  <div class="legal-callout">
    <strong>If you think you have a medical emergency, call 911 right away.</strong> Do not wait for a reply from this website.
  </div>
  <p>The information on this website is for general education only. It is not medical advice, and it does not replace a visit with a doctor. Using this website, sending us a message or reading our content does not create a doctor-patient relationship. Always talk to a qualified health care provider about your own situation.</p>

  <h2 id="appointments">Appointment requests</h2>
  <p>Sending a request through this website does not confirm an appointment. Your visit is booked only when our office contacts you and confirms the date and time. To change or cancel, please call us at <a href={site.phoneHref}>{site.phone}</a>.</p>

  <h2 id="use">Using this website</h2>
  <p>You agree to use this website only for lawful purposes. You agree not to:</p>
  <ul>
    <li>Try to break into, damage or overload the website or its servers.</li>
    <li>Send harmful code, spam or false information.</li>
    <li>Collect information about other users without their permission.</li>
    <li>Use the website in a way that harms our patients, staff or reputation.</li>
  </ul>

  <h2 id="content">Our content</h2>
  <p>The text, photos, logos, design and other material on this website belong to us or our licensors and are protected by copyright and trademark law. You may view and print pages for your own personal use. You may not copy, sell or reuse our content for other purposes without our written permission.</p>

  <h2 id="links">Links to other sites</h2>
  <p>This website may link to other websites, such as social media, lab services or forms. We do not control them and are not responsible for their content or privacy practices. A link does not mean we endorse the other site.</p>

  <h2 id="disclaimer">Disclaimer</h2>
  <p>We work hard to keep this website accurate and up to date, but we do not promise that it is always complete, current or free of errors. The website is provided "as is" and "as available".</p>

  <h2 id="liability">Limit of liability</h2>
  <p>To the fullest extent the law allows, we are not responsible for any loss or damage that comes from using this website or relying on its content. Nothing in these terms limits any right you have under law that cannot be limited.</p>

  <h2 id="law">Governing law</h2>
  <p>These terms are governed by the laws of the State of Tennessee. Any dispute will be handled in the courts located in Shelby County, Tennessee, unless the law says otherwise.</p>

  <h2 id="changes">Changes to these terms</h2>
  <p>We may update these terms from time to time. The date at the top shows the latest version. If you keep using the website after a change, it means you accept the new terms.</p>

  <h2 id="contact">Contact us</h2>
  <p>
    {site.name}<br />
    {site.address.line1}, {site.address.city}<br />
    Phone: <a href={site.phoneHref}>{site.phone}</a>
  </p>
</LegalLayout>
