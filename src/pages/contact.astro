---
import BaseLayout from "../layouts/BaseLayout.astro";
import Reveal from "../components/islands/Reveal";
import Icon from "../components/ui/Icon.astro";
import Contact from "../components/sections/Contact.astro";
import Insurance from "../components/sections/Insurance.astro";
import { site } from "../data/site";
import { patientForms } from "../data/resources";

const forms = [
  { label: "New patient registration", href: patientForms.registration },
  { label: "Medical history form", href: patientForms.medicalHistory },
  { label: "Medication during pregnancy", href: patientForms.medication },
];
---

<BaseLayout
  title="Contact Us | Martin, Lee & Page OB GYN Memphis, TN"
  description="Contact Martin, Lee & Page OB GYN in Memphis, TN. Call 901-752-4500, send a message or visit us at 6286 Briarcrest Avenue, Suite 308."
>
  <section class="bg-lagoon-900 py-20 text-white lg:py-28">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="text-sm text-lagoon-100/80">
        <a href="/" class="hover:text-white">Home</a> <span aria-hidden="true">/</span> <span class="text-white">Contact</span>
      </nav>
      <p class="eyebrow mt-8 !text-lotus-200">Contact</p>
      <h1 class="mt-4 max-w-3xl text-5xl sm:text-6xl">Contact our <em class="font-display text-lotus-200">Memphis, TN</em> office</h1>
      <p class="mt-6 max-w-2xl text-lg text-lagoon-100/85">
        Book a visit, ask a question or tell us how we can help. We are open Monday to Friday, 8:00 am to 4:30 pm. For a medical emergency, call 911.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={site.phoneHref} class="btn btn-primary btn-beam"><Icon name="phone" class="h-4 w-4" /> Call {site.phone}</a>
        <a href={site.mapLink} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Get directions</a>
      </div>
    </div>
  </section>

  <Contact />

  <section class="section bg-white">
    <div class="wrap">
      <Reveal client:visible className="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Before your visit</p>
        <h2 class="mt-4 text-4xl text-lagoon-900">Save time at <em class="font-display text-lotus-600">check-in</em></h2>
        <p class="mt-4 text-ink-soft">New patients can fill out these forms ahead of time and bring them with you.</p>
      </Reveal>
      <ul class="mx-auto mt-10 grid max-w-4xl gap-4 sm:grid-cols-3">
        {forms.map((f) => (
          <li>
            <a href={f.href} target="_blank" rel="noopener noreferrer" class="flex h-full flex-col rounded-2xl border border-lagoon-100 bg-lagoon-50 p-6 transition hover:border-lotus-300 hover:bg-white hover:shadow-lg">
              <span class="font-display text-xl text-lagoon-900">{f.label}</span>
              <span class="mt-3 inline-flex items-center gap-2 text-sm font-bold text-lotus-700">Open PDF <Icon name="external" class="h-4 w-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Insurance />
</BaseLayout>
