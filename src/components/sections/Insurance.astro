---
import { insurers } from "../../data/insurance";
import { site } from "../../data/site";
import Reveal from "../islands/Reveal";
---

<section class="border-y border-lagoon-100 bg-white py-16 lg:py-20" aria-labelledby="insurance-heading">
  <div class="wrap">
    <Reveal client:visible className="mx-auto max-w-2xl text-center">
      <p class="eyebrow">Insurance</p>
      <h2 id="insurance-heading" class="mt-3 text-3xl text-lagoon-900 sm:text-4xl">Major Insurance Providers Accepted</h2>
    </Reveal>
    <ul class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {insurers.map((i) => (
        <li class="group grid h-28 place-items-center rounded-2xl border border-lagoon-100 bg-white p-5 transition duration-500 hover:-translate-y-1 hover:border-lagoon-200 hover:shadow-xl hover:shadow-lagoon-900/10">
          <img src={i.logo} alt={i.name} loading="lazy" class="max-h-14 w-auto max-w-full object-contain opacity-80 grayscale transition duration-500 group-hover:opacity-100 group-hover:grayscale-0" />
        </li>
      ))}
    </ul>
    <p class="mt-8 text-center text-sm text-ink-soft">
      Other plans may be accepted. Please <a href={site.phoneHref} class="font-bold text-lagoon-700 underline underline-offset-4 hover:text-lotus-600">call {site.phone}</a> to check your coverage.
    </p>
  </div>
</section>
