---
import { getCollection } from "astro:content";
import { stock, type StockKey } from "../../data/images";
import Reveal from "../islands/Reveal";
import Icon from "../ui/Icon.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" });
---

<section id="blog" class="section bg-ivory">
  <div class="wrap">
    <Reveal client:visible className="flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">From Our Blog</p>
        <h2 class="mt-4 text-4xl text-lagoon-900 sm:text-5xl">Health tips and <em class="font-display text-lotus-600">news</em></h2>
      </div>
      <a href="/blog" class="btn btn-outline self-start md:self-auto">All Articles <Icon name="arrowRight" class="h-4 w-4" /></a>
    </Reveal>

    <div class="mt-14 grid gap-8 md:grid-cols-3">
      {posts.map((p, i) => (
        <Reveal client:visible delay={i * 0.1} className="h-full">
          <article class="group flex h-full flex-col overflow-hidden rounded-3xl border border-lagoon-100 bg-white transition duration-500 hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-lagoon-900/10">
            <a href={`/blog/${p.id}`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
              <img src={stock[p.data.image as StockKey]} alt="" loading="lazy" width="800" height="560" class="aspect-[4/3] w-full object-cover transition-transform duration-[1000ms] ease-[var(--ease-luxe)] group-hover:scale-105" />
            </a>
            <div class="flex flex-1 flex-col p-7">
              <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-[0.18em] text-lotus-600">
                {p.data.category}<span class="h-1 w-1 rounded-full bg-lagoon-200" aria-hidden="true"></span><span class="text-ink-soft">{p.data.readTime}</span>
              </p>
              <h3 class="mt-3 text-2xl text-lagoon-900">
                <a href={`/blog/${p.id}`} class="transition-colors hover:text-lotus-600">{p.data.title}</a>
              </h3>
              <p class="mt-3 flex-1 text-ink-soft">{p.data.description}</p>
              <div class="mt-6 flex items-center justify-between border-t border-lagoon-100 pt-5 text-sm">
                <time datetime={p.data.date.toISOString()} class="text-ink-soft">{fmt.format(p.data.date)}</time>
                <a href={`/blog/${p.id}`} class="inline-flex items-center gap-2 font-bold text-lagoon-700 group-hover:text-lotus-600" aria-label={`Read ${p.data.title}`}>
                  Read <Icon name="arrowRight" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
                </a>
              </div>
            </div>
          </article>
        </Reveal>
      ))}
    </div>
  </div>
</section>
