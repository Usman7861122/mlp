---
import type { Provider } from "../../data/providers";
interface Props {
  provider: Provider;
  class?: string;
  eager?: boolean;
}
const { provider: p, class: className = "", eager = false } = Astro.props;
---

<div class={`relative aspect-[4/5] [container-type:inline-size] overflow-hidden rounded-t-[999px] rounded-b-[2rem] shadow-lg shadow-lagoon-900/10 ${p.shape} ${className}`}>
  <img
    src={p.cutout}
    alt={`${p.name}, ${p.title}`}
    loading={eager ? "eager" : "lazy"}
    width="900"
    height="900"
    class={`absolute bottom-0 left-1/2 ${p.photoWidth} max-w-none -translate-x-1/2 transition-transform duration-[900ms] ease-[var(--ease-luxe)] group-hover:scale-[1.04]`}
  />
</div>
